    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "archiver": "^7.0.1",
    "typescript": "^6.0.3",
    "chrome-launcher": "^1.2.1",
    "vite": "^8.0.16"
  }
}
