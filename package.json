{
  "name": "chrome-extension-home-page",
  "version": "0.0.1",
  "private": true,
  "description": "Minimal Chrome new tab extension",
  "scripts": {
    "dev:server": "vite",
    "build": "vite build",
    "bundle": "npm run build && node scripts/bundle.mjs",
